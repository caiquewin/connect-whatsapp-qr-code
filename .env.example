# Copie para .env e ajuste. O .env não é versionado.
# URLs e caminhos internos do Docker são definidos no docker-compose.yml.

# Token exigido pelo serviço endpoint ("Authorization: Bearer <token>").
# Use o mesmo valor no campo Token do webhook de cada conexão (interface admin).
# Gere com: openssl rand -hex 32
ENDPOINT_TOKEN=

# --- execução local (fora do Docker) ---
# No Docker, o `environment:` do compose sobrescreve estes valores.
# Webhook local do endpoint: http://localhost:3100/messages (Docker: http://endpoint:3000/messages)
PORT=3100
# Não usada pelo app: o webhook de cada conexão é configurado na interface admin.
FORWARD_URL=http://localhost:3100/messages

# Interface admin (conexões, QR, webhook, filtros, testes): http://localhost:3200
ADMIN_PORT=3200
# Só loopback: a interface não tem login (Docker: 0.0.0.0, porta publicada só em 127.0.0.1).
# ADMIN_HOST=127.0.0.1

# Pastas de estado (relativas a apps/whatsapp). Contêm sessão, fila e dados antigos:
# nunca versionar nem copiar para a imagem (.gitignore / .dockerignore).
# AUTH_DIR=./auth
# QUEUE_DIR=./queue
# SETTINGS_DIR=./settings

# --- serviço whatsapp ---

# Resiliência do envio ao endpoint
FORWARD_TIMEOUT_MS=10000
FORWARD_BACKOFF_BASE_MS=1000
FORWARD_BACKOFF_MAX_MS=300000
# Intervalo mínimo entre dois POSTs (limite de taxa)
FORWARD_MIN_INTERVAL_MS=100

# Quantas conexões (números) a interface permite criar
MAX_CONNECTIONS=10

# O que capturar
CAPTURE_FROM_ME=true
CAPTURE_GROUPS=true
# Baixar o histórico antigo na primeira conexão (volume alto; desligado por padrão)
CAPTURE_HISTORY=false

# --- banco de dados e mídia ---
# SQLite (node:sqlite, embutido no Node): conexões, fluxos de teste, execuções,
# conversas/mensagens, metadados de mídia e eventos. No Docker: /app/db/app.db.
DB_PATH=./db/app.db
# Eventos (estado da conexão, entregas do webhook, testes) mais antigos que isso
# são apagados. 0 = guardar para sempre. Mensagens nunca são apagadas.
EVENTS_RETENTION_DAYS=90
# Mídia recebida/enviada ao vivo é baixada para MEDIA_DIR/<conexão>/<AAAA-MM>/.
MEDIA_DIR=./media
MEDIA_DOWNLOAD=true
# Arquivos maiores que isso ficam só com os metadados.
MEDIA_MAX_MB=50

# --- proxy de saída do webhook (opcional) ---
# Proxy HTTP(S) corporativo/de egress para as entregas ao webhook. Aceita
# usuário:senha na URL (codifique caracteres especiais, ex.: @ -> %40).
# O proxy do WhatsApp é por conexão, na interface admin (card > Proxy de saída).
WEBHOOK_PROXY_URL=
# Hosts que saem direto mesmo com proxy (vírgula; ".dominio.com" pega subdomínios).
WEBHOOK_NO_PROXY=localhost,127.0.0.1,::1,endpoint

# --- proxy reverso da interface admin (opcional: docker compose --profile proxy up -d) ---
# Endereço do site no Caddy: "localhost" (certificado da CA local) ou um domínio
# real apontando para esta máquina (Let's Encrypt; exige portas 80/443 públicas).
ADMIN_PROXY_SITE=localhost
# Onde publicar: 127.0.0.1 (só este computador) ou 0.0.0.0 (rede local).
ADMIN_PROXY_BIND=127.0.0.1
ADMIN_PROXY_PORT=8443
# Login obrigatório. Gere o hash com:
#   docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'sua-senha'
# e cole ENTRE ASPAS SIMPLES (o hash tem "$", que o compose interpretaria).
ADMIN_PROXY_USER=
ADMIN_PROXY_PASSWORD_HASH=''
# Domínio(s) extra(s) aceitos pela admin (proteção contra DNS rebinding). Só se
# ADMIN_PROXY_SITE for um domínio. Vírgula para vários.
ADMIN_ALLOWED_HOSTS=

# --- testes de fluxo com IA (aba "Testes com IA") ---
# O backend chama o Claude Code CLI (`claude -p`) com o login desta máquina.
# No Docker o CLI não está instalado: a aba mostra o erro e o resto funciona.
TESTER_CLAUDE_BIN=claude
TESTER_MODEL=sonnet
TESTER_AI_TIMEOUT_MS=120000
# Log de cada execução (Markdown: conversa, análises, veredito, referência usada).
TEST_LOGS_DIR=./test-logs
# Tamanho máximo da referência (card + roteiro dos fluxos do Studio) enviada à IA.
TESTER_REFERENCE_MAX_KB=400
# Se preenchido, a pasta do projeto Twilio informada na interface precisa estar
# dentro de uma destas (vírgula). Ex.: /home/voce/projetos,/mnt/c/projetos
STUDIO_ALLOWED_ROOTS=

# Card da demanda — leitura SOMENTE (GET); nada no card é alterado.
# Azure DevOps: Personal Access Token com escopo "Work Items: Read".
AZDO_PAT=
# Hosts extras do Azure DevOps (servidor próprio). Padrão: dev.azure.com, *.visualstudio.com
AZDO_HOSTS=
# Jira Cloud: e-mail + API token (id.atlassian.com > Security > API tokens).
JIRA_EMAIL=
JIRA_API_TOKEN=
# Hosts extras do Jira. Padrão: *.atlassian.net
JIRA_HOSTS=

# Execução real no Twilio Studio durante o teste — leitura SOMENTE (GET em
# studio.twilio.com). Uma conta por ambiente; prefira API Key restrita.
TWILIO_DEV_API_KEY_SID=
TWILIO_DEV_API_KEY_SECRET=
TWILIO_QA_API_KEY_SID=
TWILIO_QA_API_KEY_SECRET=
TWILIO_PROD_API_KEY_SID=
TWILIO_PROD_API_KEY_SECRET=
# Alternativa à API Key: TWILIO_<ENV>_ACCOUNT_SID + TWILIO_<ENV>_AUTH_TOKEN
# Intervalo de leitura da execução enquanto o teste roda (mín. 3000).
TESTER_STUDIO_POLL_MS=10000

# --- mensagens de aniversário (CSV) ---
# Id da conexão que envia os parabéns (8 caracteres, aparece na interface admin).
# Vazio = desligado. Verifica ~30 s após iniciar e depois 1×/dia no início da janela (BIRTHDAY_HOURS).
BIRTHDAY_CONNECTION_ID=
# Planilha: tipo;nome;numero;aniversario;sexo;mensagem;enviado (criada com modelo se não existir).
# Tem dados pessoais: fica fora do git e da imagem. No Docker: /app/birthdays/aniversarios.csv.
BIRTHDAY_CSV=./birthdays/aniversarios.csv
# Fuso que define "hoje" (o container roda em UTC).
BIRTHDAY_TZ=America/Sao_Paulo
# Intervalo médio entre duas mensagens, ±25% (mín. 3000). Volume baixo protege o número.
BIRTHDAY_SEND_INTERVAL_MS=20000
# Só envia nesta janela de horas (início-fim, no BIRTHDAY_TZ). Restart de madrugada espera até o início.
BIRTHDAY_HOURS=9-20
# Teto de parabéns por dia; o que passar disso não é enviado naquele dia.
BIRTHDAY_MAX_PER_DAY=30

# --- logs (ambos os serviços) ---
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Logs internos da Baileys são muito verbosos abaixo de warn
BAILEYS_LOG_LEVEL=warn
